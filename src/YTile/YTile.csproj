<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>ytiled</AssemblyName>
    <RootNamespace>YTile</RootNamespace>
    <AssemblyTitle>YTile daemon</AssemblyTitle>
    <PublishAot>true</PublishAot>
    <OptimizationPreference>Speed</OptimizationPreference>
    <!-- Long-running desktop daemon: workstation GC, background collection. -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.CsWin32" PrivateAssets="all" />
    <ProjectReference Include="..\YTile.Protocol\YTile.Protocol.csproj" />
    <InternalsVisibleTo Include="YTile.Tests" />
  </ItemGroup>

</Project>
